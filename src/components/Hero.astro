---
// Hero section — full-screen dark video, two-line gold headline.
// Scrolls away as a complete dark unit. No colour transitions.
---

<section class="hero" id="hero" aria-label="Hero">
  <div class="hero-sticky">

    <!-- Video — desktop -->
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/images/apex_hero_poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/apex_hero_web.mp4" type="video/mp4" />
    </video>

    <!-- Poster — mobile (video hidden via CSS) -->
    <img
      class="hero-poster"
      src="/images/apex_hero_poster.jpg"
      alt=""
      aria-hidden="true"
    />

    <!-- Headline — each line controlled independently by scroll.ts -->
    <div class="hero-content">
      <h1 class="hero-headline">
        <span class="hero-line-1" id="hero-line-1">Investment Banking for the</span>
        <span class="hero-line-2" id="hero-line-2">Exponential Age</span>
      </h1>
    </div>

  </div>
</section>

<style>
  .hero {
    height: 250vh;
    background-color: #0D0D0D;
    background-image: url('/images/apex_hero_poster.jpg');
    background-size: cover;
    background-position: center 65%;
  }

  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* ── Media ── */
  .hero-video,
  .hero-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%; /* matches section background-position */
  }

  .hero-poster { display: none; }

  @media (max-width: 768px) {
    .hero-video  { display: none; }
    .hero-poster { display: block; }
  }

  /* ── Headline ── */
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    text-align: center;
    padding-top: 20vh;
  }

  .hero-headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }

  /* Line 1 — smaller qualifier; weight-400 subordinates it to the weight-600 Line 2 */
  .hero-line-1 {
    display: block;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(18px, 2.1vw, 34px);
    color: var(--gold);
    letter-spacing: 0.025em;
    line-height: 1.2;
    opacity: 0;
  }

  /* Line 2 — dominant */
  .hero-line-2 {
    display: block;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(29px, 3.2vw, 53px);
    color: var(--gold);
    letter-spacing: 0.025em;
    line-height: 1.15;
    opacity: 0;
  }

  @media (max-width: 768px) {
    .hero-content    { padding-top: 32vh; padding-inline: 24px; }
    .hero-line-1     { font-size: clamp(22px, 6vw, 36px); }
    .hero-line-2     { font-size: clamp(38px, 10vw, 58px); }
  }
</style>
